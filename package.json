{
  "name": "omnilauncher",
  "productName": "OmniLauncher",
  "version": "1.1.0",
  "description": "All-in-one media launcher: movies, TV, music videos, books, audiobooks and games",
  "main": "main.js",
  "author": "Geletka Tech",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js && node test/imvdb.test.js",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "tech.geletka.omnilauncher",
    "productName": "OmniLauncher",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniLauncher",
      "artifactName": "OmniLauncher-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MagnusPerditor",
        "repo": "omnilauncher",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MagnusPerditor/omnilauncher.git"
  }
}
