{
  "name": "argus-launcher",
  "productName": "Argus Launcher",
  "version": "1.1.1",
  "description": "Argus Launcher: all-in-one media launcher for movies, TV, music, music videos, books, audiobooks and games",
  "main": "main.js",
  "author": "Geletka Tech",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js && node test/imvdb.test.js",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "tech.geletka.arguslauncher",
    "productName": "Argus Launcher",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "executableName": "ArgusLauncher"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Argus Launcher",
      "artifactName": "ArgusLauncher-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MagnusPerditor",
        "repo": "argus-launcher",
        "releaseType": "draft"
      }
    ],
    "directories": {
      "buildResources": "build"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MagnusPerditor/argus-launcher.git"
  }
}
